#!/bin/sh

DISTRO=`cat /etc/*-release | grep ^ID= | grep -Po '".*?"' | tr -d '"'`

cat <<EOF
This is a S2I conan.io ${DISTRO} base image:
To use it, install S2I: https://github.com/openshift/source-to-image

Sample invocation:

s2i build https://github.com/bachp/sti-conan.git --context-dir=0.7.4/test/test-app/ openshift/conan-074-${DISTRO}7 conan-sample-app

You can then run the resulting image via:
docker run -p 8080:8080 conan-sample-app
EOF
